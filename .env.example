# Copie para .env.local (que fica fora do git) e preencha.
# O Telegram tem prioridade sobre o ntfy; sem nenhum dos dois, o relatório sai no log.

TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Reserva: escolha um nome de tópico difícil de adivinhar e assine no app ntfy.
NTFY_TOPIC=
# Opcional, para servidor próprio ou tópico reservado:
NTFY_SERVER=https://ntfy.sh
NTFY_TOKEN=
